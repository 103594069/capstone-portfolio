# Copy to .env and fill in your own values. Never commit .env.
#
# This repository ships no corpus, no model and no database, so these values
# are here to document what the code reads, not to get a working system.

# --- Neo4j -------------------------------------------------------------------
# A bare Aura hostname is accepted and upgraded to an encrypted scheme by
# config.resolve_neo4j_uri; an unencrypted scheme is rejected rather than
# silently downgraded.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# On Neo4j Aura the username is the instance id, not "neo4j".
NEO4J_USERNAME=xxxxxxxx
NEO4J_PASSWORD=your-password-here

# --- Local LLM ---------------------------------------------------------------
# Inside Docker Compose, "localhost" is the app container, not the ollama
# container -- use the service name. Outside Docker, use localhost.
OLLAMA_URL=http://ollama:11434/api/generate

# Optional: a single trusted remote host allowed to serve inference, for the
# case where the model runs on another machine. Inference is constrained to
# localhost or this host in code; there is no third-party model provider.
TRUSTED_LLM_HOST=
OLLAMA_TUNNEL_SECRET=

# --- Admin upload ------------------------------------------------------------
# Shared secret for the admin paper-upload endpoint. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_UPLOAD_SECRET=generate-your-own

# --- Behaviour flags ---------------------------------------------------------
# Set to 0/false/no/off to restore pre-gate synthesis behaviour.
SYNTHESIS_RELEVANCE_GATE=1
